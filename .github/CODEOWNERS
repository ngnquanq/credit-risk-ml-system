# Ownership by path. Today one person holds every role; the handles below are placeholders
# for the teams that would review each area once required reviews are enabled.
# The last matching rule wins, so narrow rules come after the wide ones.

# Services: each folder owns its code, image and manifests
/services/loan-api/                              @credit-risk/platform
/services/scoring/                               @credit-risk/platform
/services/stream-features/                       @credit-risk/data-engineering
/services/feature-store/                         @credit-risk/data-engineering
/services/model-lifecycle/                       @credit-risk/data-science

# Narrow rules inside services
/services/loan-api/src/entrypoints/*consumer*.py @credit-risk/data-engineering
/services/loan-api/src/authz/                    @credit-risk/risk @credit-risk/security
/services/loan-api/src/audit/                    @credit-risk/security
/services/scoring/policy.py                      @credit-risk/risk

# Contracts between services. Feature definitions need producers and consumers (E2 governance plan)
/contracts/                                      @credit-risk/platform
/contracts/feature_catalog/definitions/          @credit-risk/data-engineering @credit-risk/data-science
/contracts/feature_catalog/reasons.yaml          @credit-risk/risk

# Shared library and the telemetry contract it follows. Both change together
/libs/                                           @credit-risk/platform
/contracts/telemetry/                            @credit-risk/platform @credit-risk/security

# Data: warehouse and the infrastructure services run on
/ml_data_mart/                                   @credit-risk/data-engineering
/platform/                                       @credit-risk/platform
/platform/data/                                  @credit-risk/data-engineering
/platform/foundation/identity/                     @credit-risk/platform @credit-risk/security

# Experiments and clients
/notebook/                                       @credit-risk/data-science
/portals/                                        @credit-risk/platform

# Docs
/docs/security/                                  @credit-risk/security
/docs/release/                                   @credit-risk/risk @credit-risk/platform
