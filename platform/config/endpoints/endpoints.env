# Where services find each other. Public values only: no passwords, tokens or keys (those are Secrets).
# One definition, used by every service through the shared-endpoints ConfigMap. Overlays override it per environment.
# Each consumer picks the key it needs and may map it to its own variable name with valueFrom.configMapKeyRef.

# Streaming
KAFKA_BOOTSTRAP_SERVERS=kafka-broker.data-services.svc.cluster.local:9092
DEBEZIUM_CONNECT_URL=http://debezium-connect.data-services.svc.cluster.local:8083
SCHEMA_REGISTRY_URL=http://schema-registry.data-services.svc.cluster.local:8081

# Databases (hosts only; ports, names and users stay with the service that owns them)
OPS_DB_HOST=ops-postgres.data-services.svc.cluster.local
CLICKHOUSE_HOST=clickhouse-server.data-services.svc.cluster.local

# Object storage: four MinIO instances, one per purpose
DATA_MINIO_ENDPOINT=data-minio-server.data-services.svc.cluster.local:9000
SERVING_MINIO_URL=http://serving-minio.model-serving.svc.cluster.local:9000
MODEL_REGISTRY_MINIO_URL=http://minio.model-registry.svc.cluster.local:9000
TRAINING_MINIO_URL=http://training-minio.training-data.svc.cluster.local:9000

# ML platform
MLFLOW_TRACKING_URI=http://mlflow.model-registry.svc.cluster.local:80
FEAST_REDIS_HOST=feast-redis.feature-registry.svc.cluster.local
DOCKER_REGISTRY=docker-registry.model-serving.svc.cluster.local:5000
