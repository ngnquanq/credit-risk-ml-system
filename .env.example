# =============================================================================
# Home Credit — Credit Risk Platform
# Copy this file to .env and fill in values for your environment.
# All APP_* vars are read by application/core/config.py (prefix: APP_)
# All SCORING_* vars are read by application/scoring/config.py (prefix: SCORING_)
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (operational DB)
# Default user/password match the K8s manifests in platform/data/k8s/operational-db/
# -----------------------------------------------------------------------------
OPS_DB_HOST=localhost
OPS_DB_PORT=5432
OPS_DB_USER=ops_admin
OPS_DB_PASSWORD=ops_secure_password
OPS_DB_NAME=operations

# -----------------------------------------------------------------------------
# ClickHouse (data warehouse — bureau + DWH mart data)
# Run `make pf-clickhouse` to forward port 8123 locally.
# -----------------------------------------------------------------------------
APP_CLICKHOUSE_HOST=localhost
APP_CLICKHOUSE_PORT=8123
APP_CLICKHOUSE_USER=default
APP_CLICKHOUSE_PASSWORD=

# -----------------------------------------------------------------------------
# Kafka
# Run `make pf-kafka` to forward port 9092 locally.
# -----------------------------------------------------------------------------
APP_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# -----------------------------------------------------------------------------
# MinIO (object storage — loan documents, Feast registry, Bento bundles)
# Run `make pf-minio-training` for localhost:9000.
# Default credentials match platform/data/k8s/ manifests.
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
APP_MINIO_ACCESS_KEY=minioadmin
APP_MINIO_SECRET_KEY=minioadmin
APP_MINIO_BUCKET=loan-documents

# -----------------------------------------------------------------------------
# MLflow (model registry)
# Run `make pf-mlflow` to forward port 5000 locally.
# -----------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minio_user
AWS_SECRET_ACCESS_KEY=minio_password

# -----------------------------------------------------------------------------
# Scoring service (application/scoring/config.py — prefix: SCORING_)
# Set SCORING_MODEL_SOURCE=local and SCORING_MODEL_PATH to skip MLflow for dev.
# -----------------------------------------------------------------------------
SCORING_MODEL_SOURCE=mlflow
SCORING_MODEL_PATH=
SCORING_MLFLOW_MODEL_URI=models:/credit_risk_model/Production
SCORING_PREDICTION_THRESHOLD=0.3

# Feast online store (Redis)
# Run `kubectl port-forward -n feature-registry svc/feast-redis 6379:6379` to access locally.
SCORING_FEAST_ENABLED=true
SCORING_FEAST_REPO_PATH=application/feast_repo
SCORING_FEAST_REGISTRY_URI=s3://feast-registry/feature_repo/registry.db
SCORING_FEAST_REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Application settings
# -----------------------------------------------------------------------------
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=json
