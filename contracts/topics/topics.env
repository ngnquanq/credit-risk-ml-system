# Kafka topics shared by more than one service: the contract between them. Each name is defined once, here.
# Manifests read it from the shared-topics ConfigMap (kustomization.yaml next to this file).
# Producer -> consumer, in the order an application moves through the pipeline.

# Loan API database -> Debezium -> Flink and the consumers
TOPIC_APPLICATION_CHANGES=hc.applications.public.loan_applications
# Flink -> Feast
TOPIC_APPLICATION_FEATURES=hc.application_features
TOPIC_APPLICATION_PII=hc.application_pii
# Bureau consumer -> Flink -> Feast
TOPIC_EXTERNAL_RAW=hc.application_ext_raw
TOPIC_EXTERNAL_FEATURES=hc.application_ext
# DWH feature consumer -> Feast
TOPIC_DWH_FEATURES=hc.application_dwh
# Feast says all three groups arrived (or did not) -> scoring and the decision recorder
TOPIC_FEATURE_READY=hc.feature_ready
TOPIC_FEATURE_TIMEOUT=hc.feature_timeout
# Scoring -> decision recorder
TOPIC_SCORING=hc.scoring
TOPIC_SCORING_DLQ=hc.scoring.dlq
TOPIC_DECISIONS_DLQ=hc.decisions.dlq
