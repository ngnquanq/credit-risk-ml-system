          },
          "organization_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Organization type",
            "title": "Organization Type"
          },
          "own_car_age": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Age of car in years",
            "title": "Own Car Age"
          },
          "sk_id_curr": {
            "description": "Customer ID",
            "title": "Sk Id Curr",
            "type": "string"
