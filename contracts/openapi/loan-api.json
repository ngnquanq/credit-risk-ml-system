          "age": 35,
          "annual_income": 180000.0,
          "car_age": 12,
          "children_count": 2,
          "contract_type": "Cash loans",
          "credit_amount": 406597.5,
          "documents": [
            {
              "document_type": 3,
              "file_name": "passport.pdf",
              "file_size": 2048576
            },
            {
              "document_type": 6,
              "file_name": "salary_certificate.pdf",
              "file_size": 1024768
