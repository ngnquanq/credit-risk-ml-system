  "info": {
    "description": "API for Home Credit loan applications with document upload support",
    "title": "Home Credit Loan API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/applications": {
      "post": {
        "description": "Create a loan application. Ownership comes from the verified caller, never from the body.",
        "operationId": "create_loan_application_api_v1_applications_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoanApplicationCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoanApplicationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Loan Application",
        "tags": [
          "Applications"
        ]
      }
    },
    "/api/v1/applications/{customer_id}": {
      "get": {
        "description": "Get a loan application (personal data) by customer ID.",
        "operationId": "get_loan_application_api_v1_applications__customer_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "customer_id",
            "required": true,
            "schema": {
              "title": "Customer Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoanApplicationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Loan Application",
        "tags": [
          "Applications"
        ]
      }
    },
    "/api/v1/applications/{customer_id}/decision": {
      "get": {
        "description": "Decision with plain-language reasons. No score or contributions (ADR-0013).",
        "operationId": "get_decision_api_v1_applications__customer_id__decision_get",
        "parameters": [
          {
            "in": "path",
            "name": "customer_id",
            "required": true,
            "schema": {
              "title": "Customer Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "locale",
            "required": false,
            "schema": {
              "default": "vi",
              "pattern": "^(vi|en)$",
              "title": "Locale",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Decision",
        "tags": [
          "Decisions"
        ]
      }
    },
    "/api/v1/applications/{customer_id}/explanation": {
      "get": {
        "description": "Score, band, contributions and versions of the automated decision (underwriter, auditor).",
        "operationId": "get_explanation_api_v1_applications__customer_id__explanation_get",
        "parameters": [
          {
            "in": "path",
            "name": "customer_id",
