            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Explanation",
        "tags": [
          "Decisions"
        ]
      }
    },
    "/api/v1/applications/{customer_id}/status": {
      "get": {
        "description": "Latest status; ``submitted`` until a decision is recorded (E5).",
        "operationId": "get_application_status_api_v1_applications__customer_id__status_get",
        "parameters": [
          {
            "in": "path",
            "name": "customer_id",
